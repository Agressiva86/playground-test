{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://github.com/Agressiva86/playground-test/releases/download/latest/export.wxr"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Playground Theme Preview",
				"blogdescription": "Remote preview of my block theme"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/Agressiva86/playground-test/releases/download/latest/plugin.zip"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "/wordpress/wp-content/plugins/playground-patterns/playground-patterns.php"
		},
		{
			"step": "activateTheme",
			"themeFolderName": "twentytwentyfive"
		}
	]
}
