{
  "name": "playground-patterns-plugin",
  "version": "0.1.0",
  "description": "Custom block patterns plugin development with WP Playground",
  "scripts": {
    "start": "npx @wp-playground/cli@latest server --mount=\"./plugin:/wordpress/wp-content/plugins/playground-patterns\" --mount=\"./content:/wordpress/content\" --blueprint=blueprint-local.json",
    "playground:clean": "npx @wp-playground/cli@latest server --mount=\"./plugin:/wordpress/wp-content/plugins/playground-patterns\" --mount=\"./content:/wordpress/content\" --blueprint=blueprint-local.json",
    "build:snapshot": "npx @wp-playground/cli@latest build-snapshot --blueprint=blueprint.json --outfile=./theme-demo.zip"
  },
  "keywords": [
    "wordpress",
    "playground",
    "block-patterns",
    "plugin"
  ],
  "author": "",
  "license": "ISC"
}
