{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#1a1a1a",
					"name": "Dark Background",
					"slug": "dark-bg"
				},
				{
					"color": "#2d2d2d",
					"name": "Dark Surface",
					"slug": "dark-surface"
				},
				{
					"color": "#ffffff",
					"name": "Light Text",
					"slug": "light-text"
				},
				{
					"color": "#cccccc",
					"name": "Light Gray",
					"slug": "light-gray"
				},
				{
					"color": "#007cba",
					"name": "WordPress Blue",
					"slug": "wp-blue"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--dark-bg)",
			"text": "var(--wp--preset--color--light-text)"
		},
		"typography": {
			"fontFamily": "sans-serif"
		}
	}
}
